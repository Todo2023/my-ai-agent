---
/*
 * 全ページ共通の枠組み（<head>の中身・ヘッダー・フッター）。
 * 検索エンジン向けの設定（title / description / OGP / 構造化データ）もここです。
 * 通常、この中身を編集する必要はありません。文章は src/data/site.mjs で変えられます。
 */
import { site } from '../data/site.mjs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const { title, description, path = Astro.url.pathname } = Astro.props;

// ページのタイトル。トップページだけは「会社名｜説明」の形にする。
const pageTitle = title ? `${title}｜${site.name}` : `${site.name}｜札幌の資料作成・デザイン・秘書代行・AI活用支援`;
const pageDescription = description ?? site.description;
const canonical = new URL(path, site.url).href;

// Google などに会社情報を正しく伝えるための構造化データ。
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  alternateName: site.nameEn,
  url: site.url,
  description: site.description,
  telephone: site.contact.tel,
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'JP',
    addressRegion: '北海道',
    addressLocality: '札幌市厚別区',
    postalCode: '004-0022',
    streetAddress: '厚別南1-4-3 Asterope厚別南101',
  },
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    {/* 管理画面のログイン用。招待メールのリンクを踏むと /admin/ に飛ばします。 */}
    {site.cms && (
      <>
        <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" is:inline />
        <script is:inline>
          window.netlifyIdentity &&
            window.netlifyIdentity.on('init', (user) => {
              if (!user) {
                window.netlifyIdentity.on('login', () => {
                  document.location.href = '/admin/';
                });
              }
            });
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
