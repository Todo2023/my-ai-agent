# --- Supabase -------------------------------------------------------------
# ダッシュボード以外のコマンドは service_role キーを使う（RLSを越えて読み書きするため）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# 公開ダッシュボードのHTMLに埋め込むキー。dashboard_stats ビューだけが読める
SUPABASE_ANON_KEY=your-anon-key

# --- LLM ------------------------------------------------------------------
# 物語生成・レコメンド・マッチ理由に使う。
# 未設定でも動くが、文章はテンプレートの組み立てになる
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.6-flash
# 方式C（写真→物語）で使う vision 対応モデル
# GEMINI_VISION_MODEL=gemini-3.6-flash

# --- メール送信（Gmail） ---------------------------------------------------
# 通常のパスワードではなくアプリパスワードを設定する
GMAIL_ADDRESS=todo.inc.2023.10.13@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
# 1 にすると実際には送信せず、本文の表示だけ行う
# PAWTOWN_EMAIL_DRY_RUN=1

# --- その他 ---------------------------------------------------------------
# PAWTOWN_SERVICE_NAME=Pawtown（仮）
# PAWTOWN_PRIVACY_URL=https://example.com/privacy
# 1 にすると Supabase もメールも使わず、ダミーデータで一連の流れを試せる
# DEMO_MODE=1
